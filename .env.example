# Copy this file to .env and fill in your values.

# OpenAlex API key — required by `laglitsynth catalogue-fetch`.
# Register at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Contact email for the Unpaywall API — required by
# `laglitsynth fulltext-retrieval`.
UNPAYWALL_EMAIL=

# API key of the OpenAI-compatible LLM endpoint — read by
# `laglitsynth screening-abstracts`, `fulltext-eligibility` and
# `extraction-codebook` when --api-key is not passed (an exported
# LLM_API_KEY wins over this file).
LLM_API_KEY=

# Reasoning effort for `laglitsynth extraction-codebook` in
# scripts/run-pipeline.sh: low, medium or high. Leave empty to send none
# (the provider's default). Wins over models.extraction_reasoning_effort in
# the review config.
EXTRACTION_REASONING_EFFORT=
