# Copy this file to .env and fill in your values.

# OpenAlex API key — required by `laglitsynth catalogue-fetch`.
# Register at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Contact email for the Unpaywall API — required by
# `laglitsynth fulltext-retrieval`.
UNPAYWALL_EMAIL=

# Contact email sent as the polite contact to Crossref / Semantic Scholar —
# required by `laglitsynth abstract-lookup` (falls back to this when --email
# is omitted).
ABSTRACT_LOOKUP_EMAIL=

# Semantic Scholar API key — optional; raises rate limits for
# `laglitsynth abstract-lookup` (falls back to this when --api-key is omitted).
SEMANTIC_SCHOLAR_API_KEY=

# OpenRouter API key — for running the LLM stages against a hosted model
# (https://openrouter.ai/api/v1, OpenAI-compatible) instead of local Ollama.
OPENROUTER_API_KEY=
